# prod 环境变量模板
# 复制为 /opt/soft/apps/<SERVICE_NAME>/.env 并填入真实值，不要提交真实凭证到代码库。
# 配置项说明见 specs/deployment.md 第四节（部署流程）。
#
# ⚠️  生产环境：所有 changeme 必须替换为真实值，不允许以占位符上线。

# Spring 环境
SPRING_PROFILES_ACTIVE=prod

# 数据库连接（prod 机器上的本地 PostgreSQL）
DB_URL=jdbc:postgresql://127.0.0.1:<DB_PORT>/<DB_NAME>
DB_USERNAME=<DB_NAME>
DB_PASSWORD=changeme

# JWT 签名密钥（生产环境必须使用随机值，生成方式：openssl rand -hex 32）
JWT_SECRET=changeme-MUST-replace-with-real-random-secret-openssl-rand-hex-32
