# test 环境变量模板
# 复制为 /opt/soft/apps/<SERVICE_NAME>/.env 并填入真实值，不要提交真实凭证到代码库。
# 配置项说明见 specs/deployment.md 第四节（部署流程）。

# Spring 环境
SPRING_PROFILES_ACTIVE=test

# 数据库连接（test 机器上的本地 PostgreSQL）
DB_URL=jdbc:postgresql://127.0.0.1:<DB_PORT>/<DB_NAME>
DB_USERNAME=<DB_NAME>
DB_PASSWORD=changeme

# JWT 签名密钥（test 环境建议使用随机值，与生产密钥隔离：openssl rand -hex 32）
JWT_SECRET=changeme-generate-a-random-secret-for-test
