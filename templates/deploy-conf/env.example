# 复制为 /opt/soft/apps/<SERVICE_NAME>/.env 并填入真实值，不要提交真实凭证到代码库。
# 配置项说明见 specs/deployment.md 第四节（部署流程）。

# 数据库连接
DB_URL=jdbc:postgresql://127.0.0.1:<DB_PORT>/<DB_NAME>
DB_USERNAME=<DB_NAME>
DB_PASSWORD=changeme

# JWT 签名密钥（如果服务使用 JWT 鉴权）
# 不设置时会 fallback 到 application.yml 里的开发默认值，生产环境必须覆盖为随机值：
#   openssl rand -hex 32
JWT_SECRET=changeme-generate-a-real-random-secret-for-production
