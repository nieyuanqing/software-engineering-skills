# dev 环境变量模板
# 复制为 /opt/soft/apps/<SERVICE_NAME>/.env 并填入真实值，不要提交真实凭证到代码库。
# 配置项说明见 specs/deployment.md 第四节（部署流程）。

# 数据库连接
DB_URL=jdbc:postgresql://127.0.0.1:<DB_PORT>/<DB_NAME>
DB_USERNAME=<DB_NAME>
DB_PASSWORD=changeme

# JWT 签名密钥（dev 环境可使用固定占位符，无需随机值）
JWT_SECRET=dev-insecure-placeholder-do-not-use-in-test-or-prod
