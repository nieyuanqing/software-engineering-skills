# ═══════════════════════════════════════════════════════
# <SERVICE_NAME> 环境变量 — test（测试环境独立机器）
#
# 部署位置：scripts/deploy.sh --env test 会把本文件覆盖到远端 /opt/soft/apps/<SERVICE_NAME>/.env
# 本文件不入库（.gitignore 已忽略 src/backend/**/.env*），真值只存在各自机器上。
#
# ⚠️ 键集必须与 .env（dev）、.env.prod 完全一致，只改值不改键；
#    新增/删除环境变量时三套文件同步修改。
# ═══════════════════════════════════════════════════════

# ── JVM / 容器 ─────────────────────────────────────────
JAVA_EXEC=/usr/bin/java
TZ=Asia/Shanghai

# ── Spring ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=test
SERVER_PORT=<APP_PORT>
SERVER_ADDRESS=127.0.0.1
SWAGGER_ENABLED=true
# 结构变更由 Flyway 在应用启动时自动迁移（见 .env 同项说明）
FLYWAY_ENABLED=true

# ── 数据库（test 机器上的本地 PostgreSQL）───────────────
DB_HOST=127.0.0.1
DB_PORT=<DB_PORT>
DB_NAME=<DB_NAME>
DB_USERNAME=<DB_NAME>
DB_PASSWORD=changeme

# ── 上传 ───────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE=200MB
UPLOAD_MAX_REQUEST_SIZE=210MB

