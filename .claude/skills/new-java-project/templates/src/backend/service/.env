# ═══════════════════════════════════════════════════════
# <SERVICE_NAME> 环境变量 — dev（本地开发）
#
# 部署位置：/opt/soft/apps/<SERVICE_NAME>/.env（由 scripts/deploy.sh 拷过去，supervisord 启动时加载）
# 本文件不入库（.gitignore 已忽略 src/backend/**/.env*），真值只存在各自机器上。
#
# ⚠️ 三套环境文件（.env / .env.test / .env.prod）的键集必须完全一致：
#    环境模板缺键 = 部署后远端缺该项配置，且往往静默失效而非启动报错。
#    deploy.sh 部署时会比对 dev .env 的键集并打警告。
# ═══════════════════════════════════════════════════════

# ── JVM / 容器 ─────────────────────────────────────────
# java 可执行文件绝对路径（共享主机上常用 sdkman/多版本 JDK，<JDK_VERSION> 为基线版本）
JAVA_EXEC=/usr/bin/java
TZ=Asia/Shanghai

# ── Spring ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=<APP_PORT>
# 只绑 127.0.0.1：对外访问必须经 nginx 反向代理，不要让应用端口直接暴露到公网
SERVER_ADDRESS=127.0.0.1
# OpenAPI 文档开关：dev/test 开，prod 关
SWAGGER_ENABLED=true
# schema 迁移开关：结构变更由 Flyway 在应用启动时自动迁移（脚本放 src/main/resources/db/migration/）
# 关掉它 = 新代码配旧库，启动时 jpa.hibernate.ddl-auto: validate 会直接失败
FLYWAY_ENABLED=true

# ── 数据库（PostgreSQL，<PG_VERSION> 基线）──────────────
DB_HOST=127.0.0.1
DB_PORT=<DB_PORT>
DB_NAME=<DB_NAME>
DB_USERNAME=<DB_NAME>
DB_PASSWORD=changeme

# ── 上传 ───────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE=200MB
UPLOAD_MAX_REQUEST_SIZE=210MB

