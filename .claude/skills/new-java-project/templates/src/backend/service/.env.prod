# ═══════════════════════════════════════════════════════
# <SERVICE_NAME> 环境变量 — prod（生产环境独立机器）
#
# 部署位置：scripts/deploy.sh --env prod 会把本文件覆盖到远端 /opt/soft/apps/<SERVICE_NAME>/.env
# 本文件不入库（.gitignore 已忽略 src/backend/**/.env*），真值只存在生产机器上。
#
# ⚠️ 键集必须与 .env（dev）、.env.test 完全一致，只改值不改键。
# ⚠️ 上线前所有 changeme 必须替换为真实值，不允许以占位符上线。
# ⚠️ 生产密钥单独生成，禁止复用 dev/test 的值（同一套密钥跨环境复用等于把测试环境当入口）。
# ═══════════════════════════════════════════════════════

# ── JVM / 容器 ─────────────────────────────────────────
JAVA_EXEC=/usr/bin/java
TZ=Asia/Shanghai

# ── Spring ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=<APP_PORT>
SERVER_ADDRESS=127.0.0.1
# 生产关闭 OpenAPI 文档
SWAGGER_ENABLED=false
# 生产同样由 Flyway 在应用启动时迁移：迁移失败 → 应用起不来 → 部署判失败中止，不会带坏结构接流量
FLYWAY_ENABLED=true

# ── 数据库（prod 机器上的本地 PostgreSQL）───────────────
DB_HOST=127.0.0.1
DB_PORT=<DB_PORT>
DB_NAME=<DB_NAME>
DB_USERNAME=<DB_NAME>
DB_PASSWORD=changeme

# ── 上传 ───────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE=200MB
UPLOAD_MAX_REQUEST_SIZE=210MB

