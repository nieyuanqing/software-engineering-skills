# ── 环境变量文件（含密码/密钥等敏感信息，禁止提交）──────────
# 本工程 env 文件按服务放在 src/backend/<服务名>/ 下：.env（dev）、.env.test、.env.prod，
# 三份键集必须一致（见 specs/deployment.md），真值只存在各自部署机器上，一律不入库。
.env
.env.*
*.env
env.local
*.local
application-local.yml

# ── SSL 证书与私钥（由 scripts/apply-ssl.sh 装到主机 /etc/nginx/ssl/，仓库内只放占位说明）──
deploy-conf/nginx/cert/*.pem
deploy-conf/nginx/cert/*.key

# ── SQL / 数据库文件（导出/备份常含数据与敏感信息）──────────
*.sql
*.dump
*.sqlite
*.db
# sql/backup/ 存放数据库备份导出文件，不入库
sql/backup/
# sql/update/ 存放更新 SQL 脚本，允许入库
!sql/update/*.sql

# ── 前端（HAS_WEB=true 时适用）──────────────────────────────
node_modules/
dist/
.next/
out/
npm-debug.log*
yarn-error.log*

# ── 构建/打包产物 ────────────────────────────────────────────
*.zip
*.tar.gz
mobile-apps/
# deploy.sh 的构建日志与 db 同步 dump 落地目录
runtime/
# 前端构建归档目录（deploy.sh --target web 的 tar 产物）
web-tars/

# ── Android 工程（--target android 适用）─────────────────────
# local.properties 含本机 SDK 绝对路径；.env 含 release 签名 keystore 口令，均不入库
src/android/local.properties
src/android/.env
src/android/keystore/
src/android/.gradle/

# ── 测试与扫描产物（按需提交报告时可放开）────────────────────
test/.tmp-*
test/security/sbom.cdx.json
